[Unit]
Description=ApexRust Quant - Binance Multi-Pair Trading Bot Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/apexrust-quant
Environment="RUST_LOG=info,bot_exchange=debug,bot_risk=info"
EnvironmentFile=/etc/apexrust-quant/binance.env
ExecStart=/usr/local/bin/bot-desktop --config /etc/apexrust-quant/bot.toml --web-port 8080
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apexrust-quant

[Install]
WantedBy=multi-user.target
