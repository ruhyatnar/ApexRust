# ApexRust Quant — environment configuration
# Copy to `.env` (or run ./install.sh / install.ps1, which generates it for you).
# `.env` is gitignored. Never commit real API keys.

# --- WebApp / Express proxy (server.ts) ---
PORT=3000
# Bind address: 127.0.0.1 = this computer / cloudflared local tunnel (recommended),
# 100.96.x.y = Cloudflare One Zero Trust WARP virtual IP, 0.0.0.0 = all interfaces (requires APEXRUST_PROXY_TOKEN).
HOST=127.0.0.1

# --- Binance credentials (optional; leave empty for Paper Sandbox only) ---
# Used by both the WebApp proxy and the Rust daemon (bot.toml reads these variable names).
BINANCE_ENVIRONMENT=Testnet
BINANCE_VENUE=Spot
BINANCE_AUTH_METHOD=HMAC-SHA256
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Ed25519 alternative: path to a PKCS#8 PEM private key file (or inline PEM)
BINANCE_PRIVATE_KEY_PATH=
# BINANCE_ED25519_PRIVATE_KEY=
# BINANCE_FUTURES_TESTNET_REST=
# BINANCE_SPOT_TESTNET_REST=
# BINANCE_LEVERAGE=3
# BINANCE_MARGIN_TYPE=ISOLATED
# BINANCE_RECV_WINDOW_MS=5000
# APEXRUST_MAX_ORDER_NOTIONAL_USDT=250
# APEXRUST_REQUIRE_PREFLIGHT=true
# APEXRUST_ORDER_DB_PATH=.apexrust-orders.sqlite

# --- 24/7 Remote VPS & Cloudflare One (Zero Trust) Options ---
# Single-writer engine authority: "browser" (Desktop window) or "daemon" (24/7 VPS Rust bot-desktop daemon)
# APEXRUST_ENGINE_AUTHORITY=browser
# Local upstream URL for the Rust bot-web daemon when server.ts acts as the VPS Engine Gateway
# APEXRUST_ENGINE_URL=http://127.0.0.1:8080
# Comma-separated Desktop PWA origins allowed to connect across Cloudflare One (Zero Trust)
# APEXRUST_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Persist UI-updated API keys & settings to this server's .env file (chmod 600) so keys survive VPS restarts
# APEXRUST_PERSIST_VAULT=false
# Optional >= 32-char Access Token (optional on loopback / Cloudflare One WARP 100.64.0.0/10 mesh; required on 0.0.0.0).
# Manage anytime via CLI: `./apexrust token show | generate | rotate | clear`
# APEXRUST_PROXY_TOKEN=
# APEXRUST_WEB_TOKEN=
# APEXRUST_ENGINE_TOKEN=
# APEXRUST_REMOTE_URL=
# APEXRUST_REMOTE_TOKEN=
# APEXRUST_TRUST_ZERO_TRUST_MESH=false
# Set to "loopback" or "true" behind cloudflared/reverse proxy so IP rate limiting uses CF-Connecting-IP / X-Forwarded-For
# APEXRUST_TRUST_PROXY=loopback

